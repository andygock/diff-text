{
  "name": "diff-text",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src scripts vite.config.js eslint.config.mjs --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src scripts README.md package.json vite.config.js eslint.config.mjs tsconfig.json pnpm-workspace.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:worker": "node scripts/check-worker.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "preview": "vite preview",
    "format:check": "prettier --check src scripts README.md package.json vite.config.js eslint.config.mjs tsconfig.json pnpm-workspace.yaml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "diff": "8.0.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
