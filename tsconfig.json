{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "src/library/**/*.js",
    "src/library/**/*.d.ts",
    "src/workers/**/*.js",
    "src/components/Diff.jsx"
  ],
  "exclude": ["src/**/*.test.js"]
}
